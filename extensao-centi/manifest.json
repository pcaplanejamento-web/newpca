{
  "manifest_version": 3,
  "name": "PCA Rio Verde · Automação Centi",
  "version": "1.1.0",
  "description": "Canal entre a aba Automação do sistema PCA e a Centi já aberta (sessão da aba). Só leitura: só a operação Emitir DFD, sem vincular, assinar ou enviar.",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://rioverde.centi.com.br/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://rioverde.centi.com.br/*"
      ],
      "js": [
        "centi-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://rioverde.centi.com.br/*"
      ],
      "js": [
        "centi-ponte.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://governarv.com.br/painel/automacao*",
        "https://www.governarv.com.br/painel/automacao*",
        "http://localhost:3000/painel/automacao*"
      ],
      "js": [
        "sistema-ponte.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "scripting"
  ]
}
