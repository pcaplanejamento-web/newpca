{
  "manifest_version": 3,
  "name": "PCA Rio Verde · Automação Centi",
  "version": "1.7.1",
  "description": "Canal entre a aba Automação do sistema PCA e uma aba PRÓPRIA da Centi (grupo \"Automação PCA\"). Emite DFDs, só grava um documento novo no protocolo indicado — com a autorização de uso único do sistema e a confirmação na janela da extensão —, entra sozinha com o usuário e a senha cifrados só na extensão, mostra o andamento e pode ser interrompida pelo ícone.",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://rioverde.centi.com.br/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://rioverde.centi.com.br/*"
      ],
      "js": [
        "centi-anexo.js",
        "centi-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://rioverde.centi.com.br/*"
      ],
      "js": [
        "centi-login.js",
        "centi-ponte.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://governarv.com.br/painel/automacao*",
        "https://www.governarv.com.br/painel/automacao*"
      ],
      "js": [
        "sistema-ponte.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "alarms",
    "scripting",
    "storage",
    "tabGroups"
  ],
  "action": {
    "default_title": "Automação PCA",
    "default_popup": "popup.html"
  }
}
