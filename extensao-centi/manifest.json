{
  "manifest_version": 3,
  "name": "PCA Rio Verde · Automação Centi",
  "version": "1.0.4",
  "description": "Baixa DFDs da Centi (Emitir DFD) pela aba Automação do sistema PCA, usando a sessão da Centi já aberta. Só leitura.",
  "background": { "service_worker": "background.js" },
  "host_permissions": ["https://rioverde.centi.com.br/*"],
  "content_scripts": [
    {
      "matches": ["https://rioverde.centi.com.br/*"],
      "js": ["centi-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://rioverde.centi.com.br/*"],
      "js": ["centi-ponte.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://governarv.com.br/painel/automacao*",
        "https://www.governarv.com.br/painel/automacao*",
        "http://localhost:3000/painel/automacao*"
      ],
      "js": ["sistema-ponte.js"],
      "run_at": "document_start"
    }
  ]
}
