{
  "name": "newpca",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "test": "node --experimental-strip-types --experimental-sqlite --test 'tests/**/*.test.ts'",
    "test:watch": "node --experimental-strip-types --experimental-sqlite --test --watch 'tests/**/*.test.ts'",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply newpca-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply newpca-db --remote"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "drizzle-orm": "^0.45.2",
    "geist": "^1.7.2",
    "lucide-react": "^1.44.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "wrangler": "^4.128.0"
  }
}
